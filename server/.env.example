# ResumeIQ Backend Environment Configuration (Example Template)
# Copy this file to .env for local development. DO NOT COMMIT .env TO GIT!

PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5500
MONGODB_URI=mongodb://127.0.0.1:27017/resumeiq

# Authentication Configuration (JWT)
JWT_SECRET=dev-jwt-secret-replace-with-secure-random-string-in-production
JWT_EXPIRES_IN=7d

# Optional AI Integration Configuration (AI_ENABLED defaults to false)
AI_ENABLED=false
AI_PROVIDER=mock
AI_MODEL=gemini-1.5-flash
AI_API_KEY=
